// Windows resources of the packaged game: application icon (id 1, used by the window class) and version information.
#include <winver.h>

1 ICON "../../../Content/Icons/ZeqouX3D.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ZX_VERSION_MAJOR, ZX_VERSION_MINOR, ZX_VERSION_PATCH, 0
PRODUCTVERSION ZX_VERSION_MAJOR, ZX_VERSION_MINOR, ZX_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zeqou"
            VALUE "FileDescription", "ZeqouX3D Game"
            VALUE "FileVersion", ZX_VERSION_STRING
            VALUE "InternalName", "ZXGame"
            VALUE "OriginalFilename", "ZXGame.exe"
            VALUE "ProductName", "ZeqouX3D"
            VALUE "ProductVersion", ZX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
