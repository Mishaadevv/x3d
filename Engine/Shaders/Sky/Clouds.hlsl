// Volumetric clouds (see Render/Clouds.h), in the spirit of Horizon Zero Dawn's Nubis and UE5's volumetric clouds:
//
//   Weather map  2D field over tens of kilometers: where clouds grow (coverage, in clusters with clear gaps) and what
//                kind they are (0 = stratus layers, 0.5 = cumulus heaps, 1 = towering cumulonimbus with an anvil).
//   Shape        a tiling 3D Perlin-Worley base eroded by Worley octaves, cut by the coverage and the cloud type's
//                height profile; finer Worley noise erodes the edges (wispy at the bottom, billowy at the top). The
//                shapes drift with the wind (tops lean downwind) and slowly churn.
//   Layer        a shell around the planet (the clouds curve down at the horizon and fade into the aerial haze).
//   Lighting     sun: a short cone march towards it, multiple scattering by octaves (Wrenninge / Hillaire), a two-lobe
//                phase (silver lining), powder; sky: ambient light that dims towards the cloud bottoms; lightning
//                flashes inside storm clouds.
//   Rendering    a raymarch at reduced resolution with jitter, temporal accumulation and a depth-aware composite (far
//                geometry sits inside / behind the clouds).
//   Shadows      a top-down transmittance map around the camera (ground, volumetric fog light shafts).
//
// Noise volumes and the weather map are generated by the compute shaders at the bottom.

#include "Common/Bindless.hlsli"
#include "Sky/Atmosphere.hlsli"

struct CloudParams
{
    float4x4 invViewProj;    // clip (no jitter) -> world
    float4x4 prevViewProj;
    float3 cameraPosition;
    float bottom;            // m above the ground
    float3 dirToSun;
    float thickness;         // m
    float3 sunColor;         // pre-exposed illuminance
    float coverage;
    float3 skyColor;         // pre-exposed sky light from above
    float density;           // 1/m at full
    float3 albedo;
    float detail;            // edge erosion
    float2 wind;             // m of drift so far (xz)
    float2 outputSize;       // raymarch target size
    uint shapeNoise;         // Texture3D RGBA8: Perlin-Worley, Worley x3
    uint detailNoise;        // Texture3D RGBA8: Worley x3
    uint weatherMap;         // Texture2D RGBA8: coverage, type, -, -
    uint output;             // RWTexture2D (rgba16f): in-scatter, transmittance
    uint history;            // Texture2D: last frame's result
    uint current;            // Texture2D: this frame's raymarch (temporal pass input)
    uint resolved;           // RWTexture2D: blended result
    uint depthTexture;
    uint frame;
    float historyWeight;     // 0 = none
    float shadowStrength;
    uint shadowOutput;       // RWTexture2D (rgba16f): transmittance from the sun, top-down
    uint shadowSize;
    float2 shadowOrigin;     // world xz of the map's corner
    float shadowExtent;      // m covered
    float cloudType;         // 0 stratus .. 1 cumulonimbus (the weather map varies it)
    float scale;             // size multiplier of the cloud shapes
    float evolution;         // m/s of churning (the shapes change)
    float time;
    uint steps;              // primary raymarch steps
    uint lightSteps;
    float ambient;           // sky light multiplier
    float silverLining;      // forward scattering multiplier
    float3 lightningPos;     // world
    float lightning;         // flash intensity (pre-exposed), 0 = none
    uint skyView;            // sky-view LUT (aerial haze) or invalid
    float3 skyScale;
    float hazeDistance;      // m: distant clouds fade into the sky
    float weatherScale;      // 1 / m: world xz -> weather map uv
    float2 weatherOffset;    // uv
    uint invalidDepth;       // 1: no depth texture (shadow / generation passes)
    float maxDistance;       // m of layer marched along a ray
    float2 subTexel;         // this frame's ray position inside its texel (0..1)
    float2 pad3;
    // Generation passes.
    uint genOutput;          // RWTexture3D / RWTexture2D
    uint genSize;
    uint genSliceBegin;
    uint genSeed;
    uint genSource;          // MipCS: UAV of the finer mip
    uint genSourceMip;
    uint pad1, pad2;
};
ZX_PASS_CONSTANTS(CloudParams, g_C);

#define PI 3.14159265
#define EARTH_RADIUS 6360000.0
#define SHAPE_SCALE (1.0 / 4500.0) // m -> shape noise tiles (x scale)
#define DETAIL_SCALE (1.0 / 300.0)

float Remap(float v, float lo, float hi, float newLo, float newHi)
{
    return newLo + (v - lo) / max(hi - lo, 1e-4) * (newHi - newLo);
}
float RemapSat(float v, float lo, float hi, float newLo, float newHi) { return saturate(Remap(v, lo, hi, newLo, newHi)); }

// --- Layer geometry (a shell around the planet) ------------------------------------------------------------------------

float3 PlanetCenter() { return float3(g_C.cameraPosition.x, -EARTH_RADIUS, g_C.cameraPosition.z); }

float Altitude(float3 p) { return length(p - PlanetCenter()) - EARTH_RADIUS; }

float HeightFraction(float3 p) { return (Altitude(p) - g_C.bottom) / g_C.thickness; }

/// Ray-sphere: the distances to both hits (t0 <= t1), false when it misses.
bool SphereHits(float3 origin, float3 dir, float radius, out float t0, out float t1)
{
    const float3 oc = origin - PlanetCenter();
    const float b = dot(oc, dir);
    const float c = dot(oc, oc) - radius * radius;
    const float disc = b * b - c;
    if (disc < 0.0) {
        t0 = t1 = 0.0;
        return false;
    }
    const float s = sqrt(disc);
    t0 = -b - s;
    t1 = -b + s;
    return true;
}

/// Distances along the ray where it is inside the cloud shell (the first stretch), capped at `maxLength`.
bool LayerRange(float3 origin, float3 dir, float maxLength, out float tEnter, out float tExit)
{
    const float inner = EARTH_RADIUS + g_C.bottom, outer = inner + g_C.thickness;
    const float alt = Altitude(origin) + EARTH_RADIUS;
    float i0, i1, o0, o1;
    const bool hitsInner = SphereHits(origin, dir, inner, i0, i1);
    SphereHits(origin, dir, outer, o0, o1);
    if (alt < inner) {        // below the layer: from the inner shell out to the outer one
        tEnter = i1;
        tExit = o1;
    } else if (alt < outer) { // inside: until the ray leaves the shell
        tEnter = 0.0;
        tExit = (hitsInner && i0 > 0.0) ? i0 : o1;
    } else {                  // above: from the outer shell down to the inner one (or out again)
        if (o0 <= 0.0) {
            tEnter = tExit = 0.0;
            return false;
        }
        tEnter = o0;
        tExit = (hitsInner && i0 > 0.0) ? i0 : o1;
    }
    tEnter = max(tEnter, 0.0);
    tExit = min(tExit, tEnter + maxLength);
    return tExit > tEnter;
}

// --- Cloud density -----------------------------------------------------------------------------------------------------

float4 Weather(float3 p)
{
    const float2 uv = (p.xz + g_C.wind) * g_C.weatherScale + g_C.weatherOffset;
    return GetTexture2D(g_C.weatherMap).SampleLevel(g_LinearWrap, uv, 0);
}

/// How the density of a cloud type changes with height in the layer (0..1): stratus hug the bottom, cumulus are round
/// heaps in the lower half, cumulonimbus tower to the top.
float HeightProfile(float h, float type)
{
    const float stratus = RemapSat(h, 0.0, 0.05, 0.0, 1.0) * RemapSat(h, 0.10, 0.22, 1.0, 0.0);
    const float cumulus = RemapSat(h, 0.0, 0.12, 0.0, 1.0) * RemapSat(h, 0.30, 0.65, 1.0, 0.0);
    const float nimbus = RemapSat(h, 0.0, 0.08, 0.0, 1.0) * RemapSat(h, 0.85, 1.0, 1.0, 0.0);
    return type < 0.5 ? lerp(stratus, cumulus, type * 2.0) : lerp(cumulus, nimbus, type * 2.0 - 1.0);
}

/// Density at `p` (1/m). `detail`: with the fine erosion (inside clouds only, it costs a second 3D fetch).
float CloudDensity(float3 p, bool detail, float lod)
{
    const float h = HeightFraction(p);
    if (h <= 0.0 || h >= 1.0)
        return 0.0;
    const float4 weather = Weather(p);
    const float type = saturate(weather.g);
    float coverage = weather.r;
    // Storm clouds spread out at the top (the anvil).
    coverage = saturate(coverage + type * type * RemapSat(h, 0.65, 0.9, 0.0, 0.35));
    if (coverage <= 0.01)
        return 0.0;
    const float profile = HeightProfile(h, type);
    if (profile <= 0.0)
        return 0.0;
    // Drift: tops lean downwind; the shapes churn slowly.
    const float3 q = float3(p.x, p.y, p.z) + float3(g_C.wind.x, 0.0, g_C.wind.y) * (1.0 + h * 0.15) +
                     float3(0.0, -g_C.time * g_C.evolution, 0.0);
    const float4 shape = GetTexture3D(g_C.shapeNoise).SampleLevel(g_LinearWrap, q * (SHAPE_SCALE / g_C.scale) * float3(1.0, 1.6, 1.0), lod);
    const float fbm = shape.g * 0.625 + shape.b * 0.25 + shape.a * 0.125;
    const float noise = RemapSat(shape.r, fbm - 1.0, 1.0, 0.0, 1.0);
    // Coverage cuts the noise into clouds (Nubis): more coverage, more of the noise becomes cloud.
    const float strength = RemapSat(noise * saturate(profile * 4.0), 1.0 - coverage * 0.9, 1.0, 0.0, 1.0);
    // Domes: the stronger the cloud here, the higher its top reaches (up to the type's ceiling) - no flat slabs.
    const float ceiling = type < 0.5 ? lerp(0.2, 0.62, type * 2.0) : lerp(0.62, 1.0, type * 2.0 - 1.0);
    const float top = ceiling * (0.3 + 0.7 * sqrt(strength));
    const float bottomLift = (1.0 - noise) * 0.06 * ceiling; // bases are not perfectly flat
    float base = strength * saturate((top - h) / (0.18 * ceiling)) * saturate((h - bottomLift) / 0.04) * profile * saturate(coverage * 1.5);
    if (base <= 0.0)
        return 0.0;
    if (detail && g_C.detail > 0.0 && base < 0.85) { // deep inside a cloud the erosion doesn't show
        const float3 dq = q * (DETAIL_SCALE / g_C.scale) + float3(0.0, g_C.time * g_C.evolution * 0.002, 0.0);
        const float3 d = GetTexture3D(g_C.detailNoise).SampleLevel(g_LinearWrap, dq, lod * 1.5).rgb; // far: coarser (no grain)
        const float dfbm = d.r * 0.625 + d.g * 0.25 + d.b * 0.125;
        // Wispy at the bottom, billowy towards the top.
        const float erosion = lerp(dfbm, 1.0 - dfbm, saturate(h * 6.0));
        base = RemapSat(base, erosion * g_C.detail, 1.0, 0.0, 1.0);
    }
    return base * g_C.density;
}

// --- Lighting ------------------------------------------------------------------------------------------------------------

float HG(float c, float g) { return (1.0 - g * g) / (4.0 * PI * pow(max(1.0 + g * g - 2.0 * g * c, 1e-4), 1.5)); }

float Phase(float cosSun, float g)
{
    return lerp(HG(cosSun, g), HG(cosSun, -0.25), 0.25);
}

uint Hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7FEB352Du;
    x ^= x >> 15;
    x *= 0x846CA68Bu;
    x ^= x >> 16;
    return x;
}

float InterleavedNoise(float2 p, uint frame)
{
    return frac(52.9829189 * frac(dot(p + float(frame % 16) * float2(47.0, 17.0), float2(0.06711056, 0.00583715))));
}

/// Optical depth towards the sun from `p` (a cone of growing steps; the last one reaches far for big shadows).
float SunOpticalDepth(float3 p, float jitter, uint steps)
{
    float depth = 0.0;
    float stepLen = g_C.thickness * 0.04;
    float t = stepLen * jitter;
    [loop] for (uint k = 0; k < steps; ++k) {
        const float s = (k + 1 == steps) ? stepLen * 3.0 : stepLen;
        t += s;
        depth += CloudDensity(p + g_C.dirToSun * t, k == 0, 0.5 + float(k) * 0.5) * s;
        stepLen *= 1.6;
    }
    return depth;
}

float3 SkyRadiance(float3 dir)
{
    if (g_C.skyView == ZX_INVALID_INDEX)
        return g_C.skyColor;
    dir.y = max(dir.y, 0.0);
    return GetTexture2D(g_C.skyView).SampleLevel(g_LinearClamp, SkyViewUV(normalize(dir + float3(0, 1e-4, 0))), 0).rgb * g_C.skyScale;
}

/// In-scattered light (rgb) and transmittance (a) along a view ray, up to `maxDistance`.
float4 MarchClouds(float3 origin, float3 dir, float maxDistance, float jitter, out float meanDistance)
{
    meanDistance = 0.0;
    float tEnter, tExit;
    if (!LayerRange(origin, dir, g_C.maxDistance, tEnter, tExit))
        return float4(0, 0, 0, 1);
    tExit = min(tExit, maxDistance);
    if (tExit <= tEnter)
        return float4(0, 0, 0, 1);
    const uint steps = g_C.steps;
    const float stepLen = max((tExit - tEnter) / float(steps), 25.0);
    const float cosSun = dot(dir, g_C.dirToSun);
    const float phase = Phase(cosSun, 0.75);
    const float3 sunLight = g_C.sunColor * g_C.albedo;
    float3 inscatter = 0.0;
    float transmittance = 1.0;
    float weightSum = 0.0;
    uint lit = 0;          // samples whose light towards the sun was marched
    float sunDepth = 0.0;  // reused between marches
    float t = tEnter + stepLen * jitter;
    uint emptySteps = 2;
    [loop] for (uint s = 0; s < steps * 2 && t < tExit && transmittance > 0.008; ++s) {
        const float3 pos = origin + dir * t;
        const float lod = sqrt(saturate(t / 30000.0)) * 2.5; // far clouds: blurrier noise (no shimmer, cache friendly)
        // Empty sky is crossed in double steps with the cheap density; inside clouds, single detailed ones.
        if (emptySteps > 1) {
            if (CloudDensity(pos, false, lod) <= 0.0) {
                t += stepLen * 2.0;
                continue;
            }
            emptySteps = 0;
            t = max(t - stepLen, tEnter); // step back into the edge just jumped over
            continue;
        }
        const float sigma = CloudDensity(pos, t < 25000.0, lod);
        t += stepLen;
        if (sigma <= 0.0) {
            ++emptySteps;
            continue;
        }
        emptySteps = 0;
        const float h = saturate(HeightFraction(pos));
        // The light march is the expensive part (a low sun crosses the whole layer): every sample at first, then
        // every third one (the light changes slowly inside a cloud), fewer steps far away.
        if (lit < 6 || ((lit % 4) == 0 && lit < 32))
            sunDepth = SunOpticalDepth(pos, jitter, t > 15000.0 ? 2u : g_C.lightSteps);
        ++lit;
        // Multiple scattering by octaves: each one less attenuated and less forward-peaked (Wrenninge 2013).
        float sun = 0.0;
        float a = 1.0, b = 1.0, c = 1.0;
        [unroll] for (uint o = 0; o < 3; ++o) {
            sun += a * exp(-sunDepth * b) * Phase(cosSun, 0.75 * c) * (o == 0 ? g_C.silverLining : 1.0);
            a *= 0.5;
            b *= 0.35;
            c *= 0.5;
        }
        // Powder: the dark edges of dense cumulus seen away from the sun.
        const float powder = lerp(1.0 - exp(-sigma * stepLen * 2.0), 1.0, saturate(cosSun * 0.5 + 0.5));
        // Sunlight scattered many times inside a cloud: the octaves above plus a factor for the energy of the higher
        // orders (a lit cumulus side is about as bright as a white wall in the sun). Sky light: dimmer at the bottoms.
        const float3 ambient = g_C.skyColor * g_C.ambient * lerp(0.5, 1.0, pow(h, 0.6)) + g_C.sunColor * (0.02 * saturate(g_C.dirToSun.y)); // + light bounced off the ground
        float3 scattered = (sunLight * sun * 3.2 * lerp(0.6, 1.0, powder) + ambient * g_C.albedo) * sigma;
        if (g_C.lightning > 0.0) {
            const float d = length(pos - g_C.lightningPos);
            scattered += float3(0.75, 0.8, 1.0) * g_C.lightning * exp(-d / 900.0) * sigma;
        }
        // Energy-conserving integration over the step (Hillaire 2015).
        const float tStep = exp(-sigma * stepLen);
        inscatter += transmittance * (scattered - scattered * tStep) / max(sigma, 1e-7);
        const float w = transmittance * (1.0 - tStep);
        meanDistance += t * w;
        weightSum += w;
        transmittance *= tStep;
    }
    meanDistance = weightSum > 0.0 ? meanDistance / weightSum : tEnter;
    return float4(inscatter, transmittance);
}

// --- Raymarch ------------------------------------------------------------------------------------------------------------

float3 ViewDir(float2 uv)
{
    const float4 p = mul(g_C.invViewProj, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.5, 1.0));
    return normalize(p.xyz / p.w - g_C.cameraPosition);
}

float SceneDistanceRaw(float2 uv, float raw)
{
    if (raw <= 0.0)
        return 1e9;
    const float4 p = mul(g_C.invViewProj, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, raw, 1.0));
    return length(p.xyz / p.w - g_C.cameraPosition);
}

/// Distance to the scene along the pixel's ray (huge where the sky shows).
float SceneDistance(float2 uv, float3 dir)
{
    if (g_C.invalidDepth)
        return 1e9;
    const float raw = GetTexture2D(g_C.depthTexture).SampleLevel(g_PointClamp, uv, 0).r;
    return SceneDistanceRaw(uv, raw);
}

/// The farthest scene point under a block of `block` pixels of the reduced-resolution target.
float BlockSceneDistance(float2 uv, float block)
{
    if (g_C.invalidDepth)
        return 1e9;
    Texture2D<float4> depth = GetTexture2D(g_C.depthTexture);
    uint w, h;
    depth.GetDimensions(w, h);
    const int2 c = int2(uv * float2(w, h));
    const int r = int(block * 0.5);
    float raw = depth.Load(int3(c, 0)).r;
    raw = min(raw, depth.Load(int3(clamp(c + int2(-r, -r), 0, int2(w, h) - 1), 0)).r); // reversed-Z: min = farthest
    raw = min(raw, depth.Load(int3(clamp(c + int2(r - 1, -r), 0, int2(w, h) - 1), 0)).r);
    raw = min(raw, depth.Load(int3(clamp(c + int2(-r, r - 1), 0, int2(w, h) - 1), 0)).r);
    raw = min(raw, depth.Load(int3(clamp(c + int2(r - 1, r - 1), 0, int2(w, h) - 1), 0)).r);
    return SceneDistanceRaw(uv, raw);
}


/// The pixel of each 2x2 block raymarched this frame (all four over four frames).
uint2 BlockPhase(uint frame)
{
    static const uint2 Order[4] = {uint2(0, 0), uint2(1, 1), uint2(1, 0), uint2(0, 1)};
    return Order[frame % 4];
}

/// One pixel of every 2x2 block per frame (Horizon Zero Dawn): the others keep their reprojected history.
[numthreads(8, 8, 1)]
void CloudsCS(uint3 id : SV_DispatchThreadID)
{
    const uint2 pixel = id.xy * 2 + BlockPhase(g_C.frame);
    if (any(float2(pixel) >= g_C.outputSize))
        return;
    const float2 uv = (float2(pixel) + g_C.subTexel) / g_C.outputSize;
    const float3 dir = ViewDir(uv);
    float meanDistance;
    uint fw, fh;
    GetTexture2D(g_C.depthTexture).GetDimensions(fw, fh);
    const float block = g_C.invalidDepth ? 1.0 : float(fw) / g_C.outputSize.x;
    float4 result = MarchClouds(g_C.cameraPosition, dir, BlockSceneDistance(uv, block), InterleavedNoise(float2(pixel), g_C.frame), meanDistance);
    // Distant clouds sit deep in the atmosphere: they fade into the sky's color.
    const float haze = 1.0 - exp(-meanDistance / max(g_C.hazeDistance, 1.0));
    result.rgb = lerp(result.rgb, SkyRadiance(dir) * (1.0 - result.a), haze);
    GetRWTexture2D(g_C.output)[pixel] = float4(min(result.rgb, 60000.0), result.a);
}

[numthreads(8, 8, 1)]
void TemporalCS(uint3 id : SV_DispatchThreadID)
{
    if (any(float2(id.xy) >= g_C.outputSize))
        return;
    // `current` holds this frame's pixel of each block and up to 3 frames older ones for the rest.
    const float4 cur = GetTexture2D(g_C.current).Load(int3(id.xy, 0));
    const bool rendered = all((id.xy & 1) == BlockPhase(g_C.frame));
    float4 result = cur;
    if (g_C.historyWeight > 0.0) {
        // Clouds are far away: reproject by direction.
        const float2 uv = (float2(id.xy) + 0.5) / g_C.outputSize;
        const float3 dir = ViewDir(uv);
        const float4 prev = mul(g_C.prevViewProj, float4(g_C.cameraPosition + dir * 10000.0, 1.0));
        const float2 prevUv = float2(prev.x / prev.w * 0.5 + 0.5, 0.5 - prev.y / prev.w * 0.5);
        if (prev.w > 0.0 && all(prevUv >= 0.0) && all(prevUv <= 1.0)) {
            // Variance clipping (mean +- 1.25 sigma of the neighbourhood) keeps moving edges from ghosting while the
            // noise of the jittered rays averages out.
            float4 m1 = 0, m2 = 0;
            [unroll] for (int y = -1; y <= 1; ++y)
                [unroll] for (int x = -1; x <= 1; ++x) {
                    const float4 n = GetTexture2D(g_C.current).Load(int3(clamp(int2(id.xy) + int2(x, y), 0, int2(g_C.outputSize) - 1), 0));
                    m1 += n;
                    m2 += n * n;
                }
            m1 /= 9.0;
            const float4 sigma = sqrt(max(m2 / 9.0 - m1 * m1, 0.0));
            const float4 h = clamp(GetTexture2D(g_C.history).SampleLevel(g_LinearClamp, prevUv, 0), m1 - sigma * 1.25, m1 + sigma * 1.25);
            // Fresh pixels blend in (sharper detail accumulates from the jittered rays), the others follow the history.
            result = rendered ? lerp(cur, h, 0.75) : h;
        }
    }
    GetRWTexture2D(g_C.resolved)[id.xy] = result;
}

// --- Cloud shadows (top-down transmittance towards the sun) ------------------------------------------------------------

[numthreads(8, 8, 1)]
void ShadowCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= g_C.shadowSize))
        return;
    const float2 xz = g_C.shadowOrigin + (float2(id.xy) + 0.5) / float(g_C.shadowSize) * g_C.shadowExtent;
    const float3 ground = float3(xz.x, 0.0, xz.y);
    float tEnter, tExit;
    float depth = 0.0;
    if (g_C.dirToSun.y > 0.02 && LayerRange(ground, g_C.dirToSun, 20000.0, tEnter, tExit)) {
        const float stepLen = (tExit - tEnter) / 10.0;
        float t = tEnter + stepLen * 0.5;
        for (uint s = 0; s < 10; ++s, t += stepLen)
            depth += CloudDensity(ground + g_C.dirToSun * t, false, 2.0) * stepLen;
    }
    // Light still scatters through thick clouds (overcast days aren't night): never fully black.
    const float T = max(exp(-depth * 0.6), 0.02);
    GetRWTexture2D(g_C.shadowOutput)[id.xy] = float4(lerp(1.0, T, g_C.shadowStrength).xxx, 1.0);
}

// --- Composite -----------------------------------------------------------------------------------------------------------

struct CompositeOut
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

CompositeOut CompositeVS(uint vertexId : SV_VertexID)
{
    CompositeOut o;
    o.uv = float2((vertexId << 1) & 2, vertexId & 2);
    o.position = float4(o.uv * float2(2, -2) + float2(-1, 1), 0.0, 1.0);
    return o;
}

/// Catmull-Rom filtering with nine bilinear fetches (sharp upsampling of the low-resolution clouds).
float4 SampleBicubic(Texture2D<float4> tex, float2 uv, float2 size)
{
    const float2 sp = uv * size - 0.5;
    const float2 t1 = floor(sp) + 0.5;
    const float2 f = sp + 0.5 - t1;
    const float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    const float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    const float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    const float2 w3 = f * f * (-0.5 + 0.5 * f);
    const float2 w12 = w1 + w2;
    const float2 t0 = (t1 - 1.0) / size, t3 = (t1 + 2.0) / size, t12 = (t1 + w2 / w12) / size;
    float4 r = 0;
    r += tex.SampleLevel(g_LinearClamp, float2(t0.x, t0.y), 0) * w0.x * w0.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t12.x, t0.y), 0) * w12.x * w0.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t3.x, t0.y), 0) * w3.x * w0.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t0.x, t12.y), 0) * w0.x * w12.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t12.x, t12.y), 0) * w12.x * w12.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t3.x, t12.y), 0) * w3.x * w12.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t0.x, t3.y), 0) * w0.x * w3.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t12.x, t3.y), 0) * w12.x * w3.y;
    r += tex.SampleLevel(g_LinearClamp, float2(t3.x, t3.y), 0) * w3.x * w3.y;
    return r;
}

float4 CompositePS(CompositeOut i) : SV_Target0
{
    // The sky, and geometry far enough to be inside / behind the clouds (nearer geometry keeps them out: the
    // low-resolution clouds would bleed over its edges).
    const float raw = GetTexture2D(g_C.depthTexture).Load(int3(i.position.xy, 0)).r;
    if (raw > 0.0) {
        const float3 dir = ViewDir(i.uv);
        float tEnter, tExit;
        if (!LayerRange(g_C.cameraPosition, dir, 60000.0, tEnter, tExit) || SceneDistance(i.uv, dir) < tEnter + 200.0)
            discard;
    }
    const float4 c = SampleBicubic(GetTexture2D(g_C.history), i.uv, g_C.outputSize);
    return float4(max(c.rgb, 0.0), saturate(c.a)); // blend: src One, dst SrcAlpha
}

// --- Generation (once): noise volumes and the weather map ---------------------------------------------------------------

/// pcg3d (Jarzynski & Olano 2020): three random values per lattice point with few integer multiplies (32-bit
/// multiplies are slow on integrated GPUs - the noise generation must stay far below the GPU watchdog).
float3 Hash3(uint3 v, uint seed)
{
    v = v * 1664525u + 1013904223u + seed;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return float3(v >> 8) / 16777216.0;
}

/// Tiling Worley noise: 1 at the feature points, 0 far from them.
float Worley(float3 p, float period, uint seed)
{
    const float3 cell = floor(p);
    const float3 f = p - cell;
    float best = 1.0;
    [unroll] for (int z = -1; z <= 1; ++z)
        [unroll] for (int y = -1; y <= 1; ++y)
            [unroll] for (int x = -1; x <= 1; ++x) {
                const float3 o = float3(x, y, z);
                const uint3 c = uint3(int3(cell + o)) & (uint(period) - 1u); // periods are powers of two
                const float3 d = o + Hash3(c, seed) - f;
                best = min(best, dot(d, d));
            }
    return 1.0 - saturate(sqrt(best));
}

float Gradient(float3 p, float period, uint seed)
{
    const float3 i = floor(p);
    const float3 f = p - i;
    const float3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float n[8];
    [unroll] for (uint k = 0; k < 8; ++k) {
        const float3 o = float3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        const uint3 c = uint3(int3(i + o)) & (uint(period) - 1u);
        const float3 g = Hash3(c, seed) * 2.0 - 1.0;
        n[k] = dot(g, f - o);
    }
    const float x0 = lerp(lerp(n[0], n[1], u.x), lerp(n[2], n[3], u.x), u.y);
    const float x1 = lerp(lerp(n[4], n[5], u.x), lerp(n[6], n[7], u.x), u.y);
    return lerp(x0, x1, u.z) * 0.5 + 0.5;
}

float WorleyFbm(float3 p, float period, uint seed)
{
    return Worley(p * period, period, seed) * 0.625 + Worley(p * period * 2.0, period * 2.0, seed + 1) * 0.25 +
           Worley(p * period * 4.0, period * 4.0, seed + 2) * 0.125;
}

/// Shape volume: R = Perlin-Worley (billowy), G/B/A = Worley fbm at increasing frequency.
[numthreads(4, 4, 4)]
void ShapeNoiseCS(uint3 id : SV_DispatchThreadID)
{
    const uint3 v = uint3(id.xy, id.z + g_C.genSliceBegin);
    if (any(v >= g_C.genSize))
        return;
    const float3 p = (float3(v) + 0.5) / float(g_C.genSize);
    const float perlin = Gradient(p * 4.0, 4.0, 11u) * 0.6 + Gradient(p * 8.0, 8.0, 12u) * 0.27 + Gradient(p * 16.0, 16.0, 13u) * 0.13;
    const float w = WorleyFbm(p, 4.0, 20u);
    const float perlinWorley = RemapSat(perlin, w - 1.0, 1.0, 0.0, 1.0);
    const float4 value = float4(perlinWorley, WorleyFbm(p, 4.0, 30u), WorleyFbm(p, 8.0, 40u), WorleyFbm(p, 16.0, 50u));
    RWTexture3D<float4> outTex = GetRWTexture3D(g_C.genOutput);
    outTex[v] = value;
}

/// Detail volume: Worley fbm at three frequencies.
[numthreads(4, 4, 4)]
void DetailNoiseCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= g_C.genSize))
        return;
    const float3 p = (float3(id) + 0.5) / float(g_C.genSize);
    RWTexture3D<float4> outTex = GetRWTexture3D(g_C.genOutput);
    outTex[id] = float4(WorleyFbm(p, 2.0, 60u), WorleyFbm(p, 4.0, 70u), WorleyFbm(p, 8.0, 80u), 1.0);
}

float Fbm2(float2 p, float period, uint seed)
{
    float v = 0.0, a = 0.5;
    [unroll] for (uint o = 0; o < 5; ++o) {
        v += a * Gradient(float3(p * period, 0.5), period, seed + o);
        period *= 2.0;
        a *= 0.5;
    }
    return v / 0.96875;
}

/// Weather map (tiling): R coverage (clusters with clear gaps, about `coverage` of the sky), G cloud type.
[numthreads(8, 8, 1)]
void WeatherCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= g_C.genSize))
        return;
    const float2 p = (float2(id.xy) + 0.5) / float(g_C.genSize);
    const uint seed = g_C.genSeed;
    // Large clusters (low frequency) with smaller clouds inside them.
    const float clusters = Fbm2(p, 3.0, seed);
    const float cells = Worley(float3(p * 16.0, 0.5), 16.0, seed + 9u);
    float field = clusters * 0.65 + cells * 0.35;
    // Coverage: the threshold leaves about that fraction of the map cloudy (the field is roughly normal around 0.5).
    const float c = g_C.coverage;
    const float threshold = lerp(0.78, 0.22, c);
    float coverage = RemapSat(field, threshold - 0.05, threshold + 0.12, 0.0, 1.0);
    coverage = c >= 0.98 ? 1.0 : coverage;
    coverage = saturate(coverage + c * c * c * 0.6 * (1.0 - g_C.cloudType)); // overcast stratus: a closed deck
    // Cloud type varies around the chosen one (storm cells in the middle of the big clusters).
    const float typeNoise = Fbm2(p + 0.37, 2.0, seed + 20u);
    const float type = saturate(g_C.cloudType + (typeNoise - 0.5) * 0.5 + (clusters - 0.5) * 0.4 * g_C.cloudType);
    GetRWTexture2D(g_C.genOutput)[id.xy] = float4(coverage, type, 0.0, 1.0);
}

/// One mip of a noise volume from the finer one (2x2x2 box).
[numthreads(4, 4, 4)]
void NoiseMipCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= g_C.genSize))
        return;
    RWTexture3D<float4> src = GetRWTexture3D(g_C.genSource); // the finer mip (UAV: the texture is in the UAV state)
    float4 sum = 0;
    [unroll] for (uint k = 0; k < 8; ++k)
        sum += src[id * 2 + uint3(k & 1, (k >> 1) & 1, k >> 2)];
    RWTexture3D<float4> outTex = GetRWTexture3D(g_C.genOutput);
    outTex[id] = sum * 0.125;
}
